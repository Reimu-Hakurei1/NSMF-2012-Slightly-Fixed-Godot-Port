 "creation_code": "for (i=0;i<round(room_height/10);i+=1)\r\n    {\r\n    instance_create(-40,y+i*400,o_big_marker_2)\r\n    instance_create(room_width,y+i*400,o_big_marker_2)\r\n    \r\n    instance_create(-40,y-400,o_big_marker_2)\r\n    instance_create(-40,y-800,o_big_marker_2)\r\n    instance_create(-40,y-1200,o_big_marker_2)\r\n    instance_create(room_width,y-400,o_big_marker_2)\r\n    instance_create(room_width,y-800,o_big_marker_2)\r\n    instance_create(room_width,y-1200,o_big_marker_2)\r\n    }\r\n\r\nscript_keys_init()\r\nglobal.last_level_played=2 // zmieniaj to dla kazdego etapu, zmienna dla check pointa\r\nglobal.level_death_pit=1680 // w jakim Y mario ma kusic od dziury\r\nglobal.is_subplatforms=1\r\nglobal.level_music=1\r\nglobal.time=550\r\nglobal.notime=0 // wlacz na 1 jak etap nie ma miec czasu (do etapow bonusowych)\r\nglobal.coins_red_time=0\r\nglobal.get_lives_by_jumping_on_enemies=0\r\nglobal.background_kind=30\r\nglobal.scroll_kind=1101\r\nglobal.szybciej_aktywuj_scrool_y=0\r\nglobal.fog=0\r\nglobal.przetransferuj_czas=1\r\n\r\n// stworz koniec etapu jezeli nie istnieje\r\nif instance_number(o_koniec_etapu)=0 {instance_create(-10000,-10000,o_koniec_etapu)}\r\nglobal.pauza=0",
