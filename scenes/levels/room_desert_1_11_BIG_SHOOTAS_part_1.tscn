metadata/gm_object = "o_toad_talker_stojacy"
metadata/gm_creation_code = "generuj_dialog=1\r\ntekst=\"Mario quick collect the Tanooki bonus! The Tanooki Power-up is very powerful bonus! You can change yourself into statue and be indestructible! Its easy to use! Push DOWN BUTTON + JUMP BUTTON and hold the buttons. If you want to return to Mario form, just relase buttons! One more thing you can swing tail and beat enemies by pressing FIRE BUTTON, and you can slow down the falling using JUMP BUTTON. \"\r\ntekst2=\"Te chydraulik. mam dla Ciebie nowinÄ™, zdobÄ…dÅº uszatego bonusa ktÃ³ry pozwoli Ci siÄ™ zmieniaÄ‡ w posÄ…g. Jak juÅ¼ zdobÄ™dziesz strÃ³j Tanooki, wciÅ›nij klawisz kierunku na dÃ³Å‚ i klawisz skoku - DÃ“Å� + SKOK, a zamienisz siÄ™ w niezniszczalnÄ… statuÅ‚Ä™! PowrÃ³t do formy chydraulika wystarczy puÅ›ciÄ‡ klawisze! Jeszcze jedno, moÅ¼esz uderzaÄ‡ ogonem przyciskiem FIRE, jak rÃ³wnieÅ¼ spowolniÄ‡ spadanie przyciskiem SKOKU podczas spadania lub skakania. \"\r\nshow_pic=0\r\ngoto_level=0"
position = Vector2(600, 1000)
texture = ExtResource("t30")
offset = Vector2(-20, -40)
centered = false

