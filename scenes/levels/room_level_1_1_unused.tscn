metadata/gm_object = "o_toad_talker"
metadata/gm_creation_code = "generuj_dialog=1\r\ntekst=\"Welcome Mario to New Mario Forever 2012! Mario time to lear something about walljumping! Do you know what is walljump? I can tell you.. First off jump into wall, next press opposite direction button and jump button! Try it on this wall behind us! \"\r\ntekst2=\"Hejka Mario! Witam Ciebie w nowej grze Mario Forever 2012! Od teraz Twoja przygoda zaczyna siÄ™, bÄ™dzie peÅ‚na wraÅ¼eÅ„! Oki powiem Ci coÅ› ciekawego, musisz nauczyÄ‡ skakaÄ‡ siÄ™ po Å›cianach. Aby to zrobiÄ‡ wskocz na Å›cianÄ™ trzymajÄ…c przycisk ruchu w kierunku Å›ciany, a nastÄ™pnie jak juÅ¼ nasz Mario trzyma siÄ™ Å›ciany wciskamy przycisk ruchu w odwrotnym kierunku i wciskamy klawisz skoku. SprÃ³buj zrobiÄ‡ to na tych Å›cianach. Ta umiejÄ™tnoÅ›Ä‡ bardzo Ci siÄ™ przyda w dalszej czÄ™Å›ci gry. PoÄ‡wicz trochÄ™. \"\r\nshow_pic=1\r\ngoto_level=0"
