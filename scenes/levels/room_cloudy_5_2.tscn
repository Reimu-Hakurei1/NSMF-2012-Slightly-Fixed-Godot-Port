metadata/gm_creation_code = "generuj_dialog=1\r\ntekst=\"Hello Mario! Use the mancannon. Get to the cannon using the down button, and use direction buttons to choose shot direction and push fire button to fire the mario from the cannon! Good luck!  \"\r\ntekst2=\"Mario, witam Ciebie. Poznaj nowÄ… zabawkÄ™ jakÄ… jest grzybowe dziaÅ‚o. DziÄ™ki niemu moÅ¼esz wystrzeliÄ‡ siÄ™ w przestworza! Wskocz na dziaÅ‚o, wciÅ›nij klawisz kierunku w dÃ³Å‚, i wyceluj siÄ™ w ktÃ³rym chcesz kierunku uÅ¼ywajÄ…c klawiszy kierunku lewo lub prawo, aby siÄ™ wystrzeliÄ‡ wciÅ›nij klawisz strzaÅ‚u! \"\r\nshow_pic=6\r\ngoto_level=0"
