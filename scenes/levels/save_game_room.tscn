metadata/gm_object = "o_toad_talker_stojacy"
metadata/gm_creation_code = "generuj_dialog=1\r\ntekst=\"Hi Mario! What/s up? \"\r\ntekst2=\"Co tam dobrego Mario u Ciebie? Wiesz, przydaÅ‚a by mi siÄ™ naprawa rur w toalecie. Bo niestety mi siÄ™ zapchaÅ‚y... Wiesz byÅ‚a teÅ›ciowa na domÃ³wce i za duÅ¼o zjadÅ‚a, a potem... Ale dobra, masz pewnie waÅ¼niejsze sprawy do roboty.. \"\r\nshow_pic=0\r\ngoto_level=0"
