[node name="o_toad_talker_36" type="Sprite2D" parent="Objects_0"]
metadata/gm_object = "o_toad_talker"
metadata/gm_creation_code = "generuj_dialog=1\r\ntekst=\"Here will be placed secred worlds and hardcore worlds soon! Please be patient, only one person is making this game! I know it :) \"\r\ntekst2=\"Mario nie wiem czy wiesz ale w tym miejscu bÄ™dziesz mÃ³gÅ‚ wybraÄ‡ sekretne etapy jak rÃ³wnieÅ¼ pograÄ‡ w tak zwane HARDCORE WORLDS, czyli inaczej bardzo trudne etapy.. ale autor tej gry wypuÅ›ci dodatkowe Å›wiaty w nastÄ™pnej wersji! WiÄ™c trzeba poczekaÄ‡ niestety :-( \"\r\nshow_pic=0\r\ngoto_level=0"
