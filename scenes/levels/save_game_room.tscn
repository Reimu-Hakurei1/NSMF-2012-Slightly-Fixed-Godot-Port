[node name="o_toad_talker_30" type="Sprite2D" parent="Objects_0"]
metadata/gm_object = "o_toad_talker"
metadata/gm_creation_code = "generuj_dialog=1\r\ntekst=\"Welcome Mario in New Super Mario Forever 2012! This is the acontinuation of Mario Forever! To start the game choose one of the green pipe, each pipe represents save game slot! Press down button on pipe to enter the Save Slot! If you want to clear SAVE SLOT, go to the pipe and press and hold DELETE BUTTON! Good luck Mario! \"\r\ntekst2=\"Hejka Mario! Witam CiÄ™ w grze New Super Mario Forever 2012! Jest to kontynuacja starej gry Mario Forever! Aby zaczÄ…Ä‡ grÄ™ wejdÅº na jednÄ… z zielonych rur i wciÅ›nij klawisz NA DÃ“Å�. KaÅ¼da z rur to osobny zapis gry, wiÄ™c moÅ¼esz graÄ‡ na przykÅ‚ad uÅ¼ywajÄ…c pierwszej rury a ktoÅ› z rodziny moÅ¼e uÅ¼ywaÄ‡ innej rury! Aby skasowaÄ‡ zapis przytrzymaj klawisz DELETE! Powodzonka Mario! \"\r\nshow_pic=0\r\ngoto_level=0"
position = Vector2(600, 1360)
texture = ExtResource("t38")
offset = Vector2(-20, -40)
centered = false

