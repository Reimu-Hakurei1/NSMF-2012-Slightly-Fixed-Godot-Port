[node name="o_toad_talker_260" type="Sprite2D" parent="Objects_0"]
metadata/gm_object = "o_toad_talker"
metadata/gm_creation_code = "generuj_dialog=1\r\ntekst=\"Cooool, MARIO nice to meet you personally! Ok I have some informations for you! First off look to this bunch of leafs! You know what is it? No? Good. Now go to this bush and push FIRE button to wrest it from the ground and then you can throw it into enemy or bricks. Yes yes! If you find vegetables you can throw it into bricks to destroy them! Have fun! \"\r\ntekst2=\"Åšwietnie! Mario miÅ‚o Ciebie zobaczyÄ‡ osobiÅ›cie! Mam rÃ³wnieÅ¼ dla Ciebie dobrÄ… wiadomoÅ›Ä‡! PamiÄ™tasz swoje przygody w Super Mario 2? JeÅ¼eli nie, to powiem Ci Å¼e moÅ¼esz wyrywaÄ‡ tutaj te krzaki ktÃ³re Å‚adnie na wietrze powiewajÄ…. Wyrwij je uÅ¼ywajÄ…c klawisza strzaÅ‚u i rzuÄ‡ nimi gdzie chcesz uÅ¼ywajÄ…c ponownie klawisza strzaÅ‚u! Czasami posÅ‚uÅ¼Ä… jako broÅ„ a czasami w nich moÅ¼na znaleÅºÄ‡ cenne power-upy! \"\r\nshow_pic=2\r\ngoto_level=0"
