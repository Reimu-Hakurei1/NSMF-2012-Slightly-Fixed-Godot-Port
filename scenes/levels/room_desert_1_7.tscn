metadata/gm_object = "o_toad_talker"
metadata/gm_creation_code = "generuj_dialog=1\r\ntekst=\"Mario time to learn something about rope jumping. Jump to the rope and use up and down direction buttons to climb up or down. And use direction right or left to increase the speed of swinging. Push jump button to jump from the rope! \"\r\ntekst2=\"Hey! MiÅ‚o Ciebie znowu widzieÄ‡. Oki nauczÄ™ Ciebie kolejnej fajnej rzeczy! Zaraz natrafisz na bujajÄ…ce siÄ™ liny, wskocz na jednÄ… z nich, uÅ¼ywaj klawiszy gÃ³ra dÃ³Å‚, Å¼eby wspinaÄ‡ siÄ™ na niej lub schodziÄ‡. Aby zwiÄ™kszyÄ‡ siÅ‚Ä™ bujania siÄ™ liny uÅ¼ywaj klawiszy prawo-lewo, a przycisk skuku wciÅ›nij Å¼eby z niej zeskoczyÄ‡! Powodzenia Mario! \"\r\nshow_pic=4\r\ngoto_level=0"
