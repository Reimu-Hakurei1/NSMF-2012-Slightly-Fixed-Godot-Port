[node name="o_toad_talker_1" type="Sprite2D" parent="Objects_0"]
metadata/gm_object = "o_toad_talker"
metadata/gm_creation_code = "generuj_dialog=1\r\ntekst=\"Hello Mario! Welcome to cannon training bonus stage. Here you can play with the mancannon. The game is a aquite simple and fun. Get to the cannon using the down button, and use direction buttons to choose shot direction and push fire button to fire the mario from the cannon! Good luck! Remember this level can be played only once so try to collect everything from it before complete. \"\r\ntekst2=\"Mario, witam Ciebie w sekretnym etapie. Poznaj nowÄ… zabawkÄ™ jakÄ… jest grzybowe dziaÅ‚o. DziÄ™ki niemu moÅ¼esz wystrzeliÄ‡ siÄ™ w przestworza! Wskocz na dziaÅ‚o, wciÅ›nij klawisz kierunku w dÃ³Å‚, i wyceluj siÄ™ w ktÃ³rym chcesz kierunku uÅ¼ywajÄ…c klawiszy kierunku lewo lub prawo, aby siÄ™ wystrzeliÄ‡ wciÅ›nij klawisz strzaÅ‚u! Powodzenia Mario i miÅ‚ej zabawy! Etap jest jednorazowy wiÄ™c zdobÄ…dÅº monety zanim z niego wyjdziesz! \"\r\nshow_pic=5\r\ngoto_level=0"
position = Vector2(880, 7880)
texture = ExtResource("t18")
offset = Vector2(-20, -40)
centered = false

