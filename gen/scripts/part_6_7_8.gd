static func script_wylacz_walce(S, A: Array) -> Variant:
    if R.eqv(S, S.g_wylacz_walce, 0):
        S.g_wylacz_walce = 1
        if R.lnot(R.instance_exists(S, 892)):
            G.algorytm_KULKA = 0
        if R.instance_exists(S, 892):
            G.algorytm_KULKA = 1
    return 0


static func script_sequence_coding(S, A: Array) -> Variant:
    if R.eqv(S, S.g_start, 4):
        R.room_goto_next(S)
    script_initialize_game(S, [])
    return 0


static func script_update_view(S, A: Array) -> Variant:
    R.aset(R.view_wview, 0, R.get_obj_var(925, "g_sw"))
    R.aset(R.view_hview, 0, R.get_obj_var(925, "g_sh"))
    return 0


static func script_update_window(S, A: Array) -> Variant:
    if R.eqv(S, G.widescreen, 1):
        R.set_obj_var(925, "g_sw", 1066)
        R.set_obj_var(925, "g_sh", 600)
    else:
        if R.eqv(S, G.widescreen, 2):
            R.set_obj_var(925, "g_sw", (R.window_get_width(S) * ((600 / R.window_get_height(S)))))
            R.set_obj_var(925, "g_sh", 600)
        else:
            R.set_obj_var(925, "g_sw", 800)
            R.set_obj_var(925, "g_sh", 600)
    script_update_view(S, [])
    # Only apply window changes when the player actually changes the display option; re-forcing it on every
    # room start (the GM8 workaround) would yank a maximized window back to 800x600 on every transition.
    if (((1 - R.eqv(S, G.old_windowed, G.windowed))) or ((1 - R.eqv(S, G.old_widescreen, G.widescreen)))):
        if R.eqv(S, G.windowed, 0):
