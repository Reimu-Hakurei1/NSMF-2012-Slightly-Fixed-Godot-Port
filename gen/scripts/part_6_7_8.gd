static func script_enemy_porcu_big_nice(S, A: Array) -> Variant:
    if R.eqv(S, G.pauza, 0):
        if (R.point_distance(S, S.x, S.y, G.ekran_srodek_x, G.ekran_srodek_y) <= (G.odleglosc_ekranu * 1.3)):
            if (R.random(S, 100) > 99):
                S.g_oczuje = (1 + R.random(S, 1))
            if R.eqv(S, S.g_sekwencja, 0):
                S.g_image_xscale = 1
                S.g_image_yscale = 1
                if (R.point_distance(S, S.x, S.y, R.get_obj_var(303, "g_x"), R.get_obj_var(303, "g_y")) < 200):
                    S.g_sekwencja = 1
                    S.g_kefcio = 0
                    S.g_gugu = 1
            if R.eqv(S, S.g_sekwencja, 1):
                S.g_image_xscale = (2 - (((R.cos(S, R.degtorad(S, S.g_kefcio)) * S.g_gugu)) / 2))
                S.g_kefcio += 10
                S.g_gugu -= 0.025
                if (S.g_gugu <= 0):
                    S.g_sekwencja = 2
            if R.eqv(S, S.g_sekwencja, 2):
                S.g_timer += 1
                if (S.g_timer > 200):
                    S.g_timer = 0
                    S.g_sekwencja = 3
                    S.g_kefcio = 90
                    S.g_gugu = 1
            if R.eqv(S, S.g_sekwencja, 3):
                S.g_image_xscale = (1 + ((((R.cos(S, R.degtorad(S, S.g_kefcio)) * S.g_gugu))) / 2))
                S.g_kefcio += 10
                S.g_gugu -= 0.025
                if (S.g_gugu <= 0):
                    S.g_sekwencja = 4
            if (S.g_sekwencja >= 4):
                S.g_sekwencja += 1
                if (S.g_sekwencja > 200):
                    S.g_sekwencja = 0
            S.g_image_yscale = S.g_image_xscale
            if (S.g_energy <= 0):
                S.g_kill = 10
            if R.eqv(S, S.g_kill, 10):
                P2.SXMS_SFX_PlayExt(S, [51, (((((S.x - R.anum(R.aget(R.view_xview, 0)))) / 800)) * 255), G.glosnosc_dzwieku, -(1), 0, 0])
                R.aset(S.g_lolo, 0, R.instance_create(S, S.x, S.y, 298))
                R.inst_set(R.aget(S.g_lolo, 0), "kierunek_idzie", S.g_kierunek)
                R.inst_set(R.aget(S.g_lolo, 0), "wodne_spadanie", 2)
                R.inst_set(R.aget(S.g_lolo, 0), "specjalny_kill", 6)
                R.instance_destroy(S)
            if R.eqv(S, S.g_kill, 1000):
                R.set_obj_var(303, "g_power_star_combo", (R.get_obj_var(303, "g_power_star_combo") + 1))
                P2.SXMS_SFX_PlayExt(S, [51, (((((S.x - R.anum(R.aget(R.view_xview, 0)))) / 800)) * 255), G.glosnosc_dzwieku, -(1), 0, 0])
                R.aset(S.g_lolo, 0, R.instance_create(S, S.x, S.y, 298))
                R.inst_set(R.aget(S.g_lolo, 0), "kierunek_idzie", S.g_kierunek)
                R.inst_set(R.aget(S.g_lolo, 0), "wodne_spadanie", 2)
                R.inst_set(R.aget(S.g_lolo, 0), "specjalny_kill", 6)
                R.instance_destroy(S)
            S.g_stream += 0.1
            S.y = (S.g_ystart + (R.sin(S, R.degtorad(S, S.g_stream)) * 20))
    if (R.point_distance(S, S.x, S.y, G.ekran_srodek_x, G.ekran_srodek_y) <= (G.odleglosc_ekranu * 1.6)):
        R.draw_sprite_ext(S, G.gfx_enemy_porcu_nice, 0, S.x, S.y, (S.g_image_xscale / 1.3), (S.g_image_xscale / 1.3), ((R.sin(S, (S.g_stream / 10)) * 10) + 360), 0xFFFFFF, 1)
        if (S.g_oczuje > 0):
            S.g_oczuje = (S.g_oczuje / 1.08)
            R.draw_sprite_ext(S, G.gfx_enemy_porcu_nice2, 0, S.x, S.y, (S.g_image_xscale / 1.3), (S.g_image_xscale / 1.3), ((R.sin(S, (S.g_stream / 10)) * 10) + 360), 0xFFFFFF, S.g_oczuje)
    return 0


